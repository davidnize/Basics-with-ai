<%- include('../partials/header.ejs', { pageTitle: "Log in | AI Retail Ledger" }) %>
    <main class="auth-page">
        <section class="auth-card"><span class="eyebrow">Welcome back</span>
            <h1>Log in to your ledger</h1>
            <p>Access your sales, stock, and business history.</p>
            <% if (error) { %>
                <div class="alert alert-error" role="alert">
                    <%= error %>
                </div>
                <% } %>
                    <form class="auth-form" action="/login" method="post"><label>Email address<input type="email"
                                name="email" value="<%= email || '' %>" autocomplete="email"
                                required></label><label>Password<input type="password" name="password"
                                autocomplete="current-password" required></label><button class="button"
                            type="submit">Log in</button></form>
                    <p class="auth-switch">New here? <a href="/sign-up">Create an account</a></p>
        </section>
    </main>
    <%- include('../partials/footer.ejs') %>