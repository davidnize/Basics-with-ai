<%- include('../partials/header.ejs', { pageTitle: "History | AI Retail Ledger" }) %>
<main class="app-page">
  <section class="page-heading"><div><span class="eyebrow">Your records</span><h1>History & reports</h1><p>Review sales, expenses, and profit whenever you need them.</p></div><button class="button button-small" type="button">Export CSV</button></section>
  <% if (!currentUser) { %><div class="alert alert-error" role="alert">Log in to view your saved receipts.</div><% } %>
  <section class="metric-grid"><div class="metric-card"><span>Saved receipts</span><strong><%= receipts.length %></strong></div><div class="metric-card"><span>Total recorded</span><strong><%= receipts.reduce((sum, receipt) => sum + (Number(receipt.total) || 0), 0).toFixed(2) %></strong><% const totalTax = receipts.reduce((sum, receipt) => sum + (Number(receipt.tax) || 0), 0); %><% if (totalTax > 0) { %><span>Includes <%= totalTax.toFixed(2) %> tax</span><% } %></div><div class="metric-card"><span>Latest entry</span><strong><%= receipts.length && receipts[0].createdAt ? new Date(receipts[0].createdAt).toLocaleDateString() : "—" %></strong></div></section>
  <section class="content-card"><div class="card-heading"><div><h2>Saved receipts</h2><p>Scanned receipts are stored in your account history.</p></div></div><% if (receipts.length) { %><div class="history-list"><% receipts.forEach((receipt) => { %><article class="history-entry"><div><strong><%= receipt.vendor || "Unknown vendor" %></strong><span><%= new Date(receipt.createdAt).toLocaleString() %></span><% if (Number(receipt.tax) > 0) { %><span>Tax: <%= receipt.tax %></span><% } %></div><strong class="history-total"><%= receipt.total || "—" %></strong><details><summary><%= receipt.items.length %> item(s)</summary><ul class="item-list"><% receipt.items.forEach((item) => { %><li><span><%= item.name %></span><strong><%= item.price %></strong></li><% }) %></ul></details></article><% }) %></div><% } else { %><div class="empty-state empty-state-large"><span>🗂️</span><strong>No saved receipts yet</strong><p>Scan a receipt on the Sales page, review it, and select Save scanned receipt.</p></div><% } %></section>
</main>
<%- include('../partials/footer.ejs') %>
