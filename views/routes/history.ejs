<%- include('../partials/header.ejs', { pageTitle: "History | AI Retail Ledger" }) %>
<main class="app-page">
  <%
    const totalsByCurrency = {};
    const taxByCurrency = {};
    receipts.forEach((receipt) => {
      const code = receipt.currency || defaultCurrency;
      totalsByCurrency[code] = (totalsByCurrency[code] || 0) + (Number(receipt.total) || 0);
      taxByCurrency[code] = (taxByCurrency[code] || 0) + (Number(receipt.tax) || 0);
    });
    const currencyCodes = Object.keys(totalsByCurrency);
    const utcText = (value) => new Date(value).toLocaleString("en-GB", { timeZone: "UTC", day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" }) + " UTC";
    const taxNotes = currencyCodes.filter((code) => taxByCurrency[code] > 0).map((code) => money(taxByCurrency[code], code));
  %>
  <section class="page-heading"><div><span class="eyebrow">Your records</span><h1>History & reports</h1><p>Review sales, expenses, and profit whenever you need them.</p></div><button class="button button-small" type="button">Export CSV</button></section>
  <% if (!currentUser) { %><div class="alert alert-error" role="alert">Log in to view your saved receipts.</div><% } %>
  <section class="metric-grid">
    <div class="metric-card"><span>Saved receipts</span><strong><%= receipts.length %></strong></div>
    <div class="metric-card">
      <span>Total recorded</span>
      <% if (currencyCodes.length) { %>
        <% currencyCodes.forEach((code) => { %><strong><%= money(totalsByCurrency[code], code) %></strong><% }) %>
      <% } else { %>
        <strong><%= money(0, defaultCurrency) %></strong>
      <% } %>
      <% if (taxNotes.length) { %><span>Includes <%= taxNotes.join(" · ") %> tax</span><% } %>
    </div>
    <div class="metric-card"><span>Latest entry</span><strong><% if (receipts.length && receipts[0].createdAt) { %><time class="local-date" datetime="<%= new Date(receipts[0].createdAt).toISOString() %>"><%= utcText(receipts[0].createdAt) %></time><% } else { %>—<% } %></strong></div>
  </section>
  <section class="content-card"><div class="card-heading"><div><h2>Saved receipts</h2><p>Scanned receipts are stored in your account history.</p></div></div>
  <% if (receipts.length) { %>
    <div class="history-list">
      <% receipts.forEach((receipt) => { %>
        <article class="history-entry">
          <div>
            <strong><%= receipt.vendor || "Unknown vendor" %></strong>
            <span><time class="local-time" datetime="<%= new Date(receipt.createdAt).toISOString() %>"><%= utcText(receipt.createdAt) %></time></span>
            <% if (Number(receipt.tax) > 0) { %><span>Tax: <%= money(receipt.tax, receipt.currency) %></span><% } %>
          </div>
          <strong class="history-total"><%= money(receipt.total, receipt.currency) %></strong>
          <details>
            <summary><%= receipt.items.length %> item(s)</summary>
            <ul class="item-list"><% receipt.items.forEach((item) => { %><li><span><%= item.name %></span><strong><%= money(item.price, receipt.currency) %></strong></li><% }) %></ul>
          </details>
          <details class="edit-box">
            <summary class="button button-small">Edit</summary>
            <form class="stock-form" action="/history/<%= receipt.id %>/edit" method="post">
              <label>Vendor<input name="vendor" value="<%= receipt.vendor || '' %>"></label>
              <label>Currency
                <select name="currency">
                  <% currencies.forEach((c) => { %>
                    <option value="<%= c.code %>" <%= c.code === receipt.currency ? "selected" : "" %>><%= c.code %></option>
                  <% }) %>
                </select>
              </label>
              <label>Tax<input name="tax" inputmode="decimal" value="<%= receipt.tax ?? '' %>"></label>
              <label>Total<input name="total" inputmode="decimal" value="<%= receipt.total ?? '' %>"></label>
              <% receipt.items.forEach((item) => { %>
                <label>Item<input name="itemName" value="<%= item.name %>"></label>
                <label>Price<input name="itemPrice" inputmode="decimal" value="<%= item.price ?? '' %>"></label>
              <% }) %>
              <label>New item<input name="itemName"></label>
              <label>Price<input name="itemPrice" inputmode="decimal"></label>
              <p class="stock-submit">To remove an item, clear its name.</p>
              <button class="button stock-submit" type="submit">Save changes</button>
            </form>
          </details>
          <div class="entry-buttons">
            <form action="/history/<%= receipt.id %>/delete" method="post" onsubmit="return confirm('Delete this receipt and all its items?')">
              <button class="button button-small button-danger" type="submit">Delete</button>
            </form>
          </div>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state empty-state-large"><span>🗂️</span><strong>No saved receipts yet</strong><p>Scan a receipt on the Sales page, review it, and select Save scanned receipt.</p></div>
  <% } %>
  </section>
</main>
<script>
  // Show times in the visitor's own timezone, like: Thu 22 Oct 2026 11:51
  // Hover over a time to see the full date with its timezone.
  function formatDate(date) {
    var weekday = date.toLocaleDateString(undefined, { weekday: "short" });
    var day = date.getDate();
    var month = date.toLocaleDateString(undefined, { month: "short" });
    return weekday + " " + day + " " + month + " " + date.getFullYear();
  }

  function formatTime(date) {
    return date.toLocaleTimeString(undefined, {
      hour: "2-digit",
      minute: "2-digit",
      hourCycle: "h23",
    });
  }

  document.querySelectorAll("time.local-time, time.local-date").forEach(function (el) {
    var date = new Date(el.getAttribute("datetime"));

    el.textContent = el.classList.contains("local-time")
      ? formatDate(date) + " " + formatTime(date)
      : formatDate(date);

    el.title = date.toLocaleString(undefined, {
      weekday: "long",
      day: "numeric",
      month: "long",
      year: "numeric",
      hour: "numeric",
      minute: "2-digit",
      timeZoneName: "short",
    });
  });
</script>
<%- include('../partials/footer.ejs') %>
