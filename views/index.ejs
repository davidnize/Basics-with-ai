<%- include('./partials/header.ejs') %>
   <main>
      <div class="action-grid">
         <form action="/upload" method="POST" enctype="multipart/form-data">
            <label class="drop">
               <span class="drop-icon">📁</span>
               <p>Upload Receipt</p>
               <input type="file" name="receipt" accept="image/jpeg,image/png" hidden onchange="this.form.submit()">
            </label>
         </form>

         <form action="/upload" method="POST" enctype="multipart/form-data">
            <label class="drop">
               <span class="drop-icon">📷</span>
               <p>Take Photo</p>
               <input type="file" name="receipt" accept="image/jpeg,image/png" capture="environment" required hidden
                  onchange="this.form.submit()">

            </label>
         </form>
      </div>



      <p><strong>Vendor:</strong>
         <%= Vendor || '—' %>
      </p>
      <p><strong>Total:</strong>
         <%= Total || '—' %>
      </p>
      <p><strong>Items:</strong></p>
      <ul>
         <% if (Items && Items.length) { %>
            <% Items.forEach((item)=> { %>
               <li><span>
                     <%= item.name %>
                  </span> <span>
                     <%= item.price %>
                  </span></li>
               <% }); %>

                  <% } %>
      </ul>
   </main>

   <%- include('./partials/footer.ejs') %>